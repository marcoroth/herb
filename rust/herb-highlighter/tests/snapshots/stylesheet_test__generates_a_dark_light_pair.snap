---
source: herb-highlighter/tests/stylesheet_test.rs
expression: "generate_stylesheet(get_theme(Theme::OneDark), \"onedark:github-light\",\nSome((get_theme(Theme::GithubLight), \"github-light\")))"
---
/* herb-highlight theme: onedark:github-light */

.herb-highlight {
  margin: 0;
}

.herb-highlight .herb-file-header {
  color: var(--herb-file-header, #11A8CD);
}

.herb-highlight .herb-code {
  margin: 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.herb-highlight .herb-line[data-line]::before {
  content: attr(data-line);
  display: inline-block;
  width: 3ch;
  margin-right: 1ch;
  text-align: right;
  color: var(--herb-line-number, #666666);
  user-select: none;
}

.herb-highlight .herb-line-dimmed {
  opacity: 0.6;
}

.herb-highlight .herb-line-focus[data-line]::before {
  color: var(--herb-line-number-focus, #11A8CD);
  font-weight: bold;
}

.herb-highlight .herb-token-whitespace { color: var(--herb-token-whitespace); }
.herb-highlight .herb-token-nbsp { color: var(--herb-token-nbsp); }
.herb-highlight .herb-token-newline { color: var(--herb-token-newline); }
.herb-highlight .herb-token-identifier { color: var(--herb-token-identifier); }
.herb-highlight .herb-ruby-keyword { color: var(--herb-ruby-keyword); }
.herb-highlight .herb-token-html-doctype { color: var(--herb-token-html-doctype); }
.herb-highlight .herb-token-html-tag-start { color: var(--herb-token-html-tag-start); }
.herb-highlight .herb-token-html-tag-start-close { color: var(--herb-token-html-tag-start-close); }
.herb-highlight .herb-token-html-tag-end { color: var(--herb-token-html-tag-end); }
.herb-highlight .herb-token-html-tag-self-close { color: var(--herb-token-html-tag-self-close); }
.herb-highlight .herb-token-html-comment-start { color: var(--herb-token-html-comment-start); }
.herb-highlight .herb-token-html-comment-end { color: var(--herb-token-html-comment-end); }
.herb-highlight .herb-token-erb-start { color: var(--herb-token-erb-start); }
.herb-highlight .herb-token-erb-content { color: var(--herb-token-erb-content); }
.herb-highlight .herb-token-erb-end { color: var(--herb-token-erb-end); }
.herb-highlight .herb-token-lt { color: var(--herb-token-lt); }
.herb-highlight .herb-token-slash { color: var(--herb-token-slash); }
.herb-highlight .herb-token-equals { color: var(--herb-token-equals); }
.herb-highlight .herb-token-quote { color: var(--herb-token-quote); }
.herb-highlight .herb-token-dash { color: var(--herb-token-dash); }
.herb-highlight .herb-token-underscore { color: var(--herb-token-underscore); }
.herb-highlight .herb-token-exclamation { color: var(--herb-token-exclamation); }
.herb-highlight .herb-token-semicolon { color: var(--herb-token-semicolon); }
.herb-highlight .herb-token-colon { color: var(--herb-token-colon); }
.herb-highlight .herb-token-percent { color: var(--herb-token-percent); }
.herb-highlight .herb-token-ampersand { color: var(--herb-token-ampersand); }
.herb-highlight .herb-token-character { color: var(--herb-token-character); }
.herb-highlight .herb-token-error { color: var(--herb-token-error); }
.herb-highlight .herb-token-eof { color: var(--herb-token-eof); }

.herb-highlight .herb-tag-name { color: var(--herb-token-html-tag-start); }
.herb-highlight .herb-attr-name { color: var(--herb-attr-name); }
.herb-highlight .herb-attr-value { color: var(--herb-attr-value); }
.herb-highlight .herb-comment { color: var(--herb-token-html-comment-start); }

.herb-highlight {
  --herb-token-nbsp: #5C6370;
  --herb-token-identifier: #ABB2BF;
  --herb-ruby-keyword: #C678DD;
  --herb-token-html-doctype: #61AFEF;
  --herb-token-html-tag-start: #E06C75;
  --herb-token-html-tag-start-close: #E06C75;
  --herb-token-html-tag-end: #E06C75;
  --herb-token-html-tag-self-close: #E06C75;
  --herb-token-html-comment-start: #5C6370;
  --herb-token-html-comment-end: #5C6370;
  --herb-token-erb-start: #BE5046;
  --herb-token-erb-content: #E5C07B;
  --herb-token-erb-end: #BE5046;
  --herb-token-lt: #E06C75;
  --herb-token-slash: #E06C75;
  --herb-token-equals: #56B6C2;
  --herb-token-quote: #98C379;
  --herb-token-dash: #ABB2BF;
  --herb-token-underscore: #ABB2BF;
  --herb-token-exclamation: #C678DD;
  --herb-token-semicolon: #ABB2BF;
  --herb-token-colon: #ABB2BF;
  --herb-token-percent: #BE5046;
  --herb-token-ampersand: #D19A66;
  --herb-token-character: #ABB2BF;
  --herb-token-error: #E05252;
  --herb-diff-removed-line-background: #3A2224;
  --herb-diff-added-line-background: #1E3226;
  --herb-diff-removed-background: #6B2E31;
  --herb-diff-added-background: #2E5E3D;
  --herb-attr-name: #D19A66;
  --herb-attr-value: #98C379;
}

@media (prefers-color-scheme: light) {
  .herb-highlight {
    --herb-token-nbsp: #6A737D;
    --herb-token-identifier: #24292E;
    --herb-ruby-keyword: #D73A49;
    --herb-token-html-doctype: #005CC5;
    --herb-token-html-tag-start: #22863A;
    --herb-token-html-tag-start-close: #22863A;
    --herb-token-html-tag-end: #22863A;
    --herb-token-html-tag-self-close: #22863A;
    --herb-token-html-comment-start: #6A737D;
    --herb-token-html-comment-end: #6A737D;
    --herb-token-erb-start: #E36209;
    --herb-token-erb-content: #6F42C1;
    --herb-token-erb-end: #E36209;
    --herb-token-lt: #22863A;
    --herb-token-slash: #22863A;
    --herb-token-equals: #D73A49;
    --herb-token-quote: #032F62;
    --herb-token-dash: #24292E;
    --herb-token-underscore: #24292E;
    --herb-token-exclamation: #D73A49;
    --herb-token-semicolon: #24292E;
    --herb-token-colon: #24292E;
    --herb-token-percent: #E36209;
    --herb-token-ampersand: #005CC5;
    --herb-token-character: #24292E;
    --herb-token-error: #CB2431;
    --herb-diff-removed-line-background: #FFEBE9;
    --herb-diff-added-line-background: #E6FFEC;
    --herb-diff-removed-background: #FFC9C7;
    --herb-diff-added-background: #ABF2BC;
    --herb-attr-name: #D19A66;
    --herb-attr-value: #98C379;
  }
}

