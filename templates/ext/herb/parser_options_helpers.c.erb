#include "parser_options_helpers.h"

void herb_extract_parser_options(VALUE options, parser_options_T* parser_options) {
  if (NIL_P(options)) { return; }
<%- parser_options.extractable_fields_for(:ruby).each do |field| -%>

<%- if field.boolean? -%>
  {
    VALUE value = rb_hash_lookup(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"));
    if (NIL_P(value)) { value = rb_hash_lookup(options, ID2SYM(rb_intern("<%= field.snake_case %>"))); }
    if (!NIL_P(value)) { parser_options-><%= field.c_name %> = RTEST(value); }
  }
<%- elsif field.ruby_unit == "seconds" -%>
  {
    VALUE value = rb_hash_lookup(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"));
    if (NIL_P(value)) { value = rb_hash_lookup(options, ID2SYM(rb_intern("<%= field.snake_case %>"))); }
    if (!NIL_P(value)) { parser_options-><%= field.c_name %> = (uint32_t) (NUM2DBL(value) * 1000); }
  }
<%- elsif field.nullable? -%>
  {
    VALUE sentinel = ID2SYM(rb_intern("__not_set__"));
    VALUE value = rb_hash_lookup2(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"), sentinel);
    if (value == sentinel) { value = rb_hash_lookup2(options, ID2SYM(rb_intern("<%= field.snake_case %>")), sentinel); }

    if (value != sentinel) { parser_options-><%= field.c_name %> = NIL_P(value) ? <%= field.null_sentinel %> : (uint32_t) NUM2UINT(value); }
  }
<%- else -%>
  {
    VALUE value = rb_hash_lookup(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"));
    if (NIL_P(value)) { value = rb_hash_lookup(options, ID2SYM(rb_intern("<%= field.snake_case %>"))); }
    if (!NIL_P(value)) { parser_options-><%= field.c_name %> = (uint32_t) NUM2UINT(value); }
  }
<%- end -%>
<%- end -%>
}

VALUE herb_build_parser_options_hash(const parser_options_T* options) {
  VALUE kwargs = rb_hash_new();

<%- parser_options.fields_for(:c).each do |field| -%>
<%- if field.boolean? -%>
  rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), options-><%= field.c_name %> ? Qtrue : Qfalse);
<%- elsif field.string_array? -%>
  {
    VALUE <%= field.snake_case %> = rb_ary_new_capa((long) options-><%= field.count_name %>);

    for (size_t index = 0; index < options-><%= field.count_name %>; index++) {
      hb_string_T item = options-><%= field.c_name %>[index];

      rb_ary_push(<%= field.snake_case %>, rb_utf8_str_new(item.data, (long) item.length));
    }

    rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), <%= field.snake_case %>);
  }
<%- elsif field.ruby_unit == "seconds" -%>
  rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), DBL2NUM((double) options-><%= field.c_name %> / 1000.0));
<%- elsif field.nullable? -%>
  rb_hash_aset(
    kwargs,
    ID2SYM(rb_intern("<%= field.snake_case %>")),
    options-><%= field.c_name %> == <%= field.null_sentinel %> ? Qnil : UINT2NUM(options-><%= field.c_name %>)
  );
<%- else -%>
  rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), UINT2NUM(options-><%= field.c_name %>));
<%- end -%>
<%- end -%>

  return kwargs;
}
