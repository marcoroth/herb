#include "parser_options_helpers.h"

#include <stdio.h>
#include <string.h>

bool herb_extract_parser_options(JNIEnv* env, jobject options, parser_options_T* parser_options) {
  if (options == NULL) { return true; }

  jclass optionsClass = (*env)->GetObjectClass(env, options);
<%- parser_options.extractable_fields_for(:java).each do |field| -%>

<%- if field.boolean? -%>
  {
    jmethodID method = (*env)->GetMethodID(env, optionsClass, "<%= field.java_getter %>", "<%= field.java_jni_signature %>");

    if (method != NULL) {
      jboolean value = (*env)->CallBooleanMethod(env, options, method);
      parser_options-><%= field.c_name %> = (value == JNI_TRUE);
    }
  }
<%- elsif field.string? -%>
  {
    jmethodID method = (*env)->GetMethodID(env, optionsClass, "<%= field.java_getter %>", "<%= field.java_jni_signature %>");

    if (method != NULL) {
      jstring value = (jstring) (*env)->CallObjectMethod(env, options, method);

      if (value == NULL) {
        parser_options-><%= field.c_name %>[0] = '\0';
      } else {
        const char* string = (*env)->GetStringUTFChars(env, value, NULL);
        size_t length = strlen(string);

<%- if field.validator -%>
        if (!<%= field.validator %>(string, length)) {
          char message[96];
          snprintf(message, sizeof(message), "<%= field.snake_case %> \"%.32s\" is not supported", string);
          (*env)->ReleaseStringUTFChars(env, value, string);
          (*env)->ThrowNew(env, (*env)->FindClass(env, "java/lang/IllegalArgumentException"), message);

          return false;
        }
<%- else -%>
        if (length >= HERB_PARSER_OPTIONS_STRING_CAPACITY) {
          (*env)->ReleaseStringUTFChars(env, value, string);
          (*env)->ThrowNew(env, (*env)->FindClass(env, "java/lang/IllegalArgumentException"), "<%= field.snake_case %> is too long");

          return false;
        }
<%- end -%>

        memcpy(parser_options-><%= field.c_name %>, string, length + 1);
        (*env)->ReleaseStringUTFChars(env, value, string);
      }
    }
  }
<%- elsif field.nullable? -%>
  {
    jmethodID method = (*env)->GetMethodID(env, optionsClass, "<%= field.java_getter %>", "<%= field.java_jni_signature %>");

    if (method != NULL) {
      jobject value = (*env)->CallObjectMethod(env, options, method);

      if (value == NULL) {
        parser_options-><%= field.c_name %> = <%= field.null_sentinel %>;
      } else {
        jclass integerClass = (*env)->FindClass(env, "java/lang/Integer");
        jmethodID intValue = (*env)->GetMethodID(env, integerClass, "intValue", "()I");
        parser_options-><%= field.c_name %> = (uint32_t) (*env)->CallIntMethod(env, value, intValue);
      }
    }
  }
<%- else -%>
  {
    jmethodID method = (*env)->GetMethodID(env, optionsClass, "<%= field.java_getter %>", "<%= field.java_jni_signature %>");

    if (method != NULL) {
      jint value = (*env)->CallIntMethod(env, options, method);
      parser_options-><%= field.c_name %> = (uint32_t) value;
    }
  }
<%- end -%>
<%- end -%>

  return true;
}
