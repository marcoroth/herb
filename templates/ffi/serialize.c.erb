// Serializes results for lib/herb/ffi/deserialize.rb as little-endian uint32 words.
// Strings are a length (UINT32_MAX for NULL) and bytes padded to a word; optional
// values start with a presence word.

#define HERB_FFI_NULL_LENGTH UINT32_MAX

static void write_u32(hb_buffer_T* buffer, uint32_t value) {
  uint8_t bytes[4] = {
    (uint8_t) (value & 0xff),
    (uint8_t) ((value >> 8) & 0xff),
    (uint8_t) ((value >> 16) & 0xff),
    (uint8_t) ((value >> 24) & 0xff)
  };
  hb_buffer_append_with_length(buffer, (const char*) bytes, 4);
}

static void write_data(hb_buffer_T* buffer, const void* data, size_t length) {
  static const char padding[3] = { 0 };

  if (data == NULL) {
    write_u32(buffer, HERB_FFI_NULL_LENGTH);
    return;
  }

  write_u32(buffer, (uint32_t) length);
  hb_buffer_append_with_length(buffer, data, length);
  hb_buffer_append_with_length(buffer, padding, (4 - length % 4) % 4);
}

static void write_string(hb_buffer_T* buffer, hb_string_T string) {
  write_data(buffer, string.data, string.length);
}

static void write_location(hb_buffer_T* buffer, location_T location) {
  write_u32(buffer, location.start.line);
  write_u32(buffer, location.start.column);
  write_u32(buffer, location.end.line);
  write_u32(buffer, location.end.column);
}

static void write_token(hb_buffer_T* buffer, const token_T* token, bool track_locations) {
  write_u32(buffer, token != NULL);
  if (token == NULL) { return; }

  write_string(buffer, token->value);
  write_u32(buffer, track_locations);

  if (track_locations) {
    write_u32(buffer, token->range.from);
    write_u32(buffer, token->range.to);
    write_location(buffer, token->location);
  }

  write_u32(buffer, (uint32_t) token->type);
}

static void write_prism_node(hb_buffer_T* buffer, herb_prism_node_T prism_node) {
  if (prism_node.node == NULL || prism_node.parser == NULL) {
    write_u32(buffer, HERB_FFI_NULL_LENGTH);
    return;
  }

  pm_buffer_t* pm_buffer = pm_buffer_new();
  herb_prism_node_serialize(prism_node, pm_buffer);

  if (pm_buffer_length(pm_buffer) > 0) {
    write_data(buffer, pm_buffer_value(pm_buffer), pm_buffer_length(pm_buffer));
  } else {
    write_u32(buffer, HERB_FFI_NULL_LENGTH);
  }

  pm_buffer_free(pm_buffer);
}

static void write_error(hb_buffer_T* buffer, ERROR_T* error) {
  write_u32(buffer, error != NULL);
  if (error == NULL) { return; }

  write_u32(buffer, (uint32_t) error->type);
  write_location(buffer, error->location);
  write_string(buffer, error->message);

  switch (error->type) {
  <%- errors.each do |error| -%>
    case <%= error.type %>: {
      <%- if error.fields.any? -%>
      <%= error.struct_type %>* <%= error.human %> = (<%= error.struct_type %>*) error;
      <%- end -%>
      <%- error.fields.each do |field| -%>
      <%- case field -%>
      <%- when Herb::Template::PositionField -%>
      write_u32(buffer, <%= error.human %>-><%= field.name %>.line);
      write_u32(buffer, <%= error.human %>-><%= field.name %>.column);
      <%- when Herb::Template::TokenField -%>
      write_token(buffer, <%= error.human %>-><%= field.name %>, true);
      <%- when Herb::Template::TokenTypeField -%>
      write_u32(buffer, (uint32_t) <%= error.human %>-><%= field.name %>);
      <%- when Herb::Template::StringField -%>
      // Ruby gets "" here rather than nil, same as the C extension (rb_utf8_str_new)
      write_string(buffer, hb_string_is_null(<%= error.human %>-><%= field.name %>) ? HB_STRING_EMPTY : <%= error.human %>-><%= field.name %>);
      <%- when Herb::Template::SizeTField -%>
      write_u32(buffer, (uint32_t) <%= error.human %>-><%= field.name %>);
      <%- else -%>
      #error "Unhandled error field type <%= field.class.name %>"
      <%- end -%>
      <%- end -%>
      break;
    }
  <%- end -%>
  }
}

static void write_errors(hb_buffer_T* buffer, hb_array_T* array) {
  size_t size = array ? hb_array_size(array) : 0;
  write_u32(buffer, (uint32_t) size);

  for (size_t index = 0; index < size; index++) {
    write_error(buffer, hb_array_get(array, index));
  }
}

static void write_node(hb_buffer_T* buffer, AST_NODE_T* node, const parser_options_T* options);

static void write_nodes(hb_buffer_T* buffer, hb_array_T* array, const parser_options_T* options) {
  size_t size = array ? hb_array_size(array) : 0;
  write_u32(buffer, (uint32_t) size);

  for (size_t index = 0; index < size; index++) {
    write_node(buffer, hb_array_get(array, index), options);
  }
}

static void write_node(hb_buffer_T* buffer, AST_NODE_T* node, const parser_options_T* options) {
  write_u32(buffer, node != NULL);
  if (node == NULL) { return; }

  write_u32(buffer, (uint32_t) node->type);
  write_u32(buffer, options->track_locations);
  if (options->track_locations) { write_location(buffer, node->location); }
  write_errors(buffer, node->errors);

  switch (node->type) {
  <%- nodes.each do |node| -%>
    case <%= node.type %>: {
      <%- if node.fields.any? -%>
      <%= node.struct_type %>* <%= node.human %> = (<%= node.struct_type %>*) node;
      <%- end -%>
      <%- node.fields.each do |field| -%>
      <%- case field -%>
      <%- when Herb::Template::StringField, Herb::Template::ElementSourceField -%>
      write_string(buffer, <%= node.human %>-><%= field.name %>);
      <%- when Herb::Template::NodeField, Herb::Template::BorrowedNodeField -%>
      write_node(buffer, (AST_NODE_T*) <%= node.human %>-><%= field.name %>, options);
      <%- when Herb::Template::TokenField -%>
      write_token(buffer, <%= node.human %>-><%= field.name %>, options->track_locations);
      <%- when Herb::Template::BooleanField -%>
      write_u32(buffer, <%= node.human %>-><%= field.name %>);
      <%- when Herb::Template::ArrayField -%>
      write_nodes(buffer, <%= node.human %>-><%= field.name %>, options);
      <%- when Herb::Template::LocationField -%>
      write_u32(buffer, options->track_locations && <%= node.human %>-><%= field.name %> != NULL);
      if (options->track_locations && <%= node.human %>-><%= field.name %> != NULL) { write_location(buffer, *<%= node.human %>-><%= field.name %>); }
      <%- when Herb::Template::PrismSerializedField -%>
      write_data(buffer, <%= node.human %>-><%= field.name %>.length ? <%= node.human %>-><%= field.name %>.data : NULL, <%= node.human %>-><%= field.name %>.length);
      <%- when Herb::Template::PrismNodeField -%>
      write_prism_node(buffer, <%= node.human %>-><%= field.name %>);
      <%- when Herb::Template::AnalyzedRubyField, Herb::Template::PrismContextField, Herb::Template::VoidPointerField -%>
      /* <%= field.name %> is internal parser state, not exposed to Ruby */
      <%- else -%>
      #error "Unhandled node field type <%= field.class.name %>"
      <%- end -%>
      <%- end -%>
      break;
    }
  <%- end -%>
  }
}

// Output uses malloc so Ruby can free it with herb_ffi_free.
static bool output_init(hb_buffer_T* buffer, hb_allocator_T* allocator, size_t capacity) {
  *allocator = hb_allocator_with_malloc();
  return hb_buffer_init(buffer, capacity, allocator);
}

static void output_finish(hb_buffer_T* buffer, uint8_t** out, size_t* out_length) {
  *out = (uint8_t*) buffer->value;
  *out_length = buffer->length;
}

HERB_EXPORTED_FUNCTION void herb_ffi_free(void* data) {
  free(data);
}

HERB_EXPORTED_FUNCTION size_t herb_ffi_parser_options_size(void) {
  return sizeof(parser_options_T);
}

