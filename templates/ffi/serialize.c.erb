}

HERB_EXPORTED_FUNCTION bool herb_ffi_parse(
  const char* source,
  const parser_options_T* options,
  uint8_t** out,
  size_t* out_length
) {
  hb_allocator_T allocator;
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!hb_allocator_init(&allocator, HB_ALLOCATOR_ARENA)) { return false; }

  if (!output_init(&output, &output_allocator, 4096)) {
    hb_allocator_destroy(&allocator);
    return false;
  }

  AST_DOCUMENT_NODE_T* root = herb_parse(source, options, &allocator);
  write_node(&output, (AST_NODE_T*) root, options);

  if (root != NULL) { ast_node_free((AST_NODE_T*) root, &allocator); }
  hb_allocator_destroy(&allocator);

  output_finish(&output, out, out_length);
  return true;
}

HERB_EXPORTED_FUNCTION bool herb_ffi_lex(
  const char* source,
  const parser_options_T* options,
  uint8_t** out,
  size_t* out_length
) {
  hb_allocator_T allocator;
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!hb_allocator_init(&allocator, HB_ALLOCATOR_ARENA)) { return false; }

  if (!output_init(&output, &output_allocator, 4096)) {
    hb_allocator_destroy(&allocator);
    return false;
  }

  hb_array_T* tokens = herb_lex_with_options(source, options, &allocator);
  size_t size = tokens ? hb_array_size(tokens) : 0;
  write_u32(&output, (uint32_t) size);

  for (size_t index = 0; index < size; index++) {
    write_token(&output, hb_array_get(tokens, index), true);
  }

  if (tokens != NULL) { herb_free_tokens(&tokens, &allocator); }
  hb_allocator_destroy(&allocator);

  output_finish(&output, out, out_length);
  return true;
}

static char* extract(const char* source, const herb_extract_ruby_options_T* options) {
  hb_allocator_T allocator;
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!hb_allocator_init(&allocator, HB_ALLOCATOR_ARENA)) { return NULL; }

  if (!output_init(&output, &output_allocator, strlen(source))) {
    hb_allocator_destroy(&allocator);
    return NULL;
  }

  if (options != NULL) {
    herb_extract_ruby_to_buffer_with_options(source, &output, options, &allocator);
  } else {
    herb_extract_html_to_buffer(source, &output, &allocator);
  }

  hb_allocator_destroy(&allocator);

  return output.value;
}

HERB_EXPORTED_FUNCTION char* herb_ffi_extract_ruby(const char* source, const herb_extract_ruby_options_T* options) {
  return extract(source, options);
}

HERB_EXPORTED_FUNCTION char* herb_ffi_extract_html(const char* source) {
  return extract(source, NULL);
}

HERB_EXPORTED_FUNCTION bool herb_ffi_diff(
  const char* old_source,
  const char* new_source,
  bool track_whitespace_changes,
  uint8_t** out,
  size_t* out_length
) {
  herb_diff_options_T diff_options = HERB_DEFAULT_DIFF_OPTIONS;
  diff_options.track_whitespace_changes = track_whitespace_changes;

  hb_allocator_T allocator;
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!hb_allocator_init(&allocator, HB_ALLOCATOR_ARENA)) { return false; }

  if (!output_init(&output, &output_allocator, 4096)) {
    hb_allocator_destroy(&allocator);
    return false;
  }

  AST_DOCUMENT_NODE_T* old_root = herb_parse(old_source, &HERB_DEFAULT_PARSER_OPTIONS, &allocator);
  AST_DOCUMENT_NODE_T* new_root = herb_parse(new_source, &HERB_DEFAULT_PARSER_OPTIONS, &allocator);
  bool parsed = old_root != NULL && new_root != NULL;

  herb_diff_result_T* result = parsed ? herb_diff(old_root, new_root, &diff_options, &allocator) : NULL;
  bool diffed = result != NULL;

  if (diffed) {
    size_t count = herb_diff_operation_count(result);

    write_u32(&output, result->trees_identical);
    write_u32(&output, (uint32_t) count);

    for (size_t index = 0; index < count; index++) {
      const herb_diff_operation_T* operation = herb_diff_operation_at(result, index);
      const char* type = herb_diff_operation_type_to_string(operation->type);

      write_data(&output, type, strlen(type));
      write_u32(&output, operation->path.depth);

      for (uint16_t depth = 0; depth < operation->path.depth; depth++) {
        write_u32(&output, operation->path.indices[depth]);
      }

      write_node(&output, (AST_NODE_T*) operation->old_node, &HERB_DEFAULT_PARSER_OPTIONS);
      write_node(&output, (AST_NODE_T*) operation->new_node, &HERB_DEFAULT_PARSER_OPTIONS);
      write_u32(&output, operation->old_index);
      write_u32(&output, operation->new_index);
    }
  }

  if (old_root != NULL) { ast_node_free((AST_NODE_T*) old_root, &allocator); }
  if (new_root != NULL) { ast_node_free((AST_NODE_T*) new_root, &allocator); }
  hb_allocator_destroy(&allocator);

  if (!diffed) {
    free(output.value);
    return false;
  }

  output_finish(&output, out, out_length);
  return true;
}

HERB_EXPORTED_FUNCTION bool herb_ffi_ruby_syntax_errors(
  const char* source,
  size_t length,
  uint8_t** out,
  size_t* out_length
) {
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!output_init(&output, &output_allocator, 256)) { return false; }

  pm_arena_t* arena = pm_arena_new();
  pm_parser_t* parser = pm_parser_new(arena, (const uint8_t*) source, length, NULL);
  pm_parse(parser);

  const pm_line_offset_list_t* line_offsets = pm_parser_line_offsets(parser);
  int32_t start_line = pm_parser_start_line(parser);

  write_u32(&output, (uint32_t) pm_parser_errors_size(parser));

  for (const pm_diagnostic_t* error = pm_parser_errors_first(parser); error != NULL;
       error = pm_diagnostic_next(error)) {
    const char* type = pm_diagnostic_type(error);
    const char* message = pm_diagnostic_message(error);
    pm_line_column_t position =
      pm_line_offset_list_line_column(line_offsets, pm_diagnostic_location(error).start, start_line);

    write_data(&output, type, strlen(type));
    write_data(&output, message, strlen(message));
    write_u32(&output, (uint32_t) position.line);
  }

  pm_parser_free(parser);
  pm_arena_free(arena);

  output_finish(&output, out, out_length);
  return true;
}
