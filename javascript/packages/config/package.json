{
  "name": "@herb-tools/config",
  "version": "0.10.3",
  "description": "Shared configuration utilities for Herb tools",
  "license": "MIT",
  "homepage": "https://herb-tools.dev",
  "bugs": "https://github.com/marcoroth/herb/issues/new?title=Package%20%60@herb-tools/config%60:%20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoroth/herb.git",
    "directory": "javascript/packages/config"
  },
  "main": "./dist/herb-config.cjs",
  "module": "./dist/herb-config.esm.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && tsc --emitDeclarationOnly && rolldown -c",
    "dev": "tsc --emitDeclarationOnly -w",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "yarn clean && yarn build && yarn test"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/herb-config.esm.js",
      "require": "./dist/herb-config.cjs",
      "default": "./dist/herb-config.esm.js"
    },
    "./schema": {
      "types": "./dist/types/config-schema.d.ts",
      "import": "./dist/herb-config-schema.esm.js",
      "require": "./dist/herb-config-schema.cjs",
      "default": "./dist/herb-config-schema.esm.js"
    }
  },
  "dependencies": {
    "@herb-tools/core": "0.10.3",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.16",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "files": [
    "package.json",
    "README.md",
    "src/",
    "dist/"
  ]
}
