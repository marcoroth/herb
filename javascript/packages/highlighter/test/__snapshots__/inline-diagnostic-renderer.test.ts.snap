// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`InlineDiagnosticRenderer > marks every line a multi-line diagnostic spans 1`] = `
"/test/file.erb

      1 │ <div id="gems">
  →   2 │   <% @gems.each do |topic_gem| %>
        │   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  →   3 │     <%= render partial: "gem_card" %>
        │     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  →   4 │   <% end %>
        │   ~~~~~~~~~
        │   [warning] Multi-line offense (multi-line-rule)
        │
      5 │ </div>"
`;

exports[`InlineDiagnosticRenderer > renders a single-line diagnostic with its message under the marker 1`] = `
"/test/file.erb

      1 │ line 1
  →   2 │ line <error> content
        │      ~~~~~
        │      [error] Test error message (test-rule)
        │
      3 │ line 3"
`;

exports[`InlineDiagnosticRenderer > renders markers without line numbers 1`] = `
"line 1
line <error> content
     ~~~~~
[error] Test error message (test-rule)

line 3"
`;

exports[`InlineDiagnosticRenderer > renders the message once, under the last line of a multi-line diagnostic 1`] = `
"/test/file.erb

  →   1 │ <% if true %>
        │ ~~~~~~~~~~~~~
  →   2 │   <span>content</span>
        │   ~~~~~~~~~~~~~~~~~~~~
  →   3 │ <% end %>
        │ ~~~~~~~~~
        │ [error] Multi-line offense (test-rule)"
`;

exports[`InlineDiagnosticRenderer > renders with the simple theme 1`] = `
"[36m/test/file.erb[0m

    [90m  1[0m [90m│[0m [37mline[0m [37m1[0m
[91m  → [0m[1m  2[0m [90m│[0m [37mline[0m [31m<[0m[31merror[0m[31m>[0m [37mcontent[0m
        [90m│[0m      [91m~~~~~[0m
        [90m│[0m      [[2;1m[2;91merror[0m[0m] Test error message (test-rule)
        [90m│[0m
    [90m  3[0m [90m│[0m [37mline[0m [37m3[0m"
`;

exports[`InlineDiagnosticRenderer > renders without color 1`] = `
"/test/file.erb

      1 │ line 1
  →   2 │ line <error> content
        │      ~~~~~
        │      [error] Test error message (test-rule)
