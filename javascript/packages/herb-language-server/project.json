  "sourceRoot": "javascript/packages/herb-language-server/src",
  "projectType": "library",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/dist", "{projectRoot}/tsconfig.tsbuildinfo"],
      "executor": "nx:run-script",
      "options": {
