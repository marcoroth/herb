{
  "name": "@herb-tools/language-server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "javascript/packages/language-server/src",
  "projectType": "library",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/dist", "{projectRoot}/tsconfig.tsbuildinfo"],
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "dependsOn": [
        "@herb-tools/config:build",
        "@herb-tools/core:build",
        "@herb-tools/formatter:build",
        "@herb-tools/linter:build",
        "@herb-tools/node-wasm:build",
        "@herb-tools/printer:build",
        "@herb-tools/rewriter:build"
      ]
    },
    "test": {
      "executor": "nx:run-script",
      "options": {
        "script": "test"
      }
    },
    "clean": {
      "executor": "nx:run-script",
      "options": {
        "script": "clean"
      }
    }
  },
  "tags": []
}
