{
  "name": "@herb-tools/dev-tools",
  "version": "0.10.3",
  "description": "Development tools for visual debugging of HTML+ERB templates",
  "type": "module",
  "license": "MIT",
  "homepage": "https://herb-tools.dev",
  "bugs": "https://github.com/marcoroth/herb/issues/new?title=Package%20%60@herb-tools/dev-tools%60:%20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoroth/herb.git",
    "directory": "javascript/packages/dev-tools"
  },
  "main": "./dist/herb-dev-tools.esm.js",
  "module": "./dist/herb-dev-tools.esm.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "yarn clean && tsc --emitDeclarationOnly && rolldown -c",
    "dev": "rolldown -c -w",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "yarn clean && yarn build && yarn test"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/herb-dev-tools.esm.js"
    }
  },
  "dependencies": {
    "@herb-tools/core": "0.10.3",
    "@herb-tools/client": "0.10.3"
  },
  "files": [
    "package.json",
    "README.md",
    "dist/",
    "src/"
  ]
}
