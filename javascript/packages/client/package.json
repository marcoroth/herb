{
  "name": "@herb-tools/client",
  "version": "0.10.3",
  "description": "Browser runtime for indexing and updating the slots an HTML+ERB template renders",
  "type": "module",
  "license": "MIT",
  "homepage": "https://herb-tools.dev",
  "bugs": "https://github.com/marcoroth/herb/issues/new?title=Package%20%60@herb-tools/client%60:%20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoroth/herb.git",
    "directory": "javascript/packages/client"
  },
  "main": "./dist/herb-client.esm.js",
  "module": "./dist/herb-client.esm.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "yarn clean && tsc --emitDeclarationOnly && rolldown -c",
    "dev": "rolldown -c -w",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepublishOnly": "yarn clean && yarn build && yarn test"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/herb-client.esm.js",
      "default": "./dist/herb-client.esm.js"
    }
  },
  "dependencies": {},
  "files": [
    "package.json",
    "README.md",
    "dist/"
  ]
}
