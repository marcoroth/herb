<li class="herb-report-stat"><span class="herb-report-stat-value">1</span><span class="herb-report-stat-label">file with offenses</span></li>
<li class="herb-report-stat"><span class="herb-report-stat-value">3</span><span class="herb-report-stat-label">clean files</span></li>
<li class="herb-report-stat"><span class="herb-report-stat-value">1</span><span class="herb-report-stat-label">error</span></li>
<li class="herb-report-stat"><span class="herb-report-stat-value">1</span><span class="herb-report-stat-label">rule enabled</span></li>
</ul>
</header>
<section class="herb-report-rail">
<h2 class="herb-report-rail-title">Rules with offenses</h2>
<ul class="herb-report-rule-list">
<li class="herb-report-rule"><a class="herb-report-rule-name" href="https://herb-tools.dev/linter/rules/html-no-nested-forms" rel="noopener noreferrer">html-no-nested-forms</a><span class="herb-report-rule-count">1</span></li>
</ul>
</section>
<details class="herb-report-file" open>
<summary class="herb-report-file-summary">
<span class="herb-report-file-name">app/views/posts/_actions.html.erb</span>
<span class="herb-report-file-count">1 offense</span>
</summary>
<article class="herb-report-card">
<header class="herb-report-card-header">
<span class="herb-report-dot herb-report-dot-error"></span>
<span class="herb-report-card-rule">html-no-nested-forms</span>
</header>
<div class="herb-report-excerpt">
