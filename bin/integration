#!/bin/bash

set -e  # Exit on error

bundle exec rake clean
bundle install
bundle exec rake

./run_herb_tests

./herb lex examples/test.html.erb
./herb ruby examples/test.html.erb
./herb html examples/test.html.erb
./herb parse examples/test.html.erb
./herb prism examples/test.html.erb

bin/leaks_lex examples/test.html.erb
bin/leaks_parse examples/test.html.erb

bin/lint
bin/tidy
# TODO: Back to `bundle exec rubocop` once https://github.com/rubocop/rubocop-ast/pull/420 is released.
BUNDLE_GEMFILE=gemfiles/rubocop.gemfile bundle exec rubocop
BUNDLE_GEMFILE=gemfiles/rubocop.gemfile bundle exec ruby test/rubocop/includes_assertion_test.rb

echo ""
echo "Integration successful!"
