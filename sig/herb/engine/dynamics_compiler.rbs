        def initialize: (untyped, ?Hash[Symbol, untyped]) -> void

        # : (untyped) -> void
        def visit_erb_iteration_block_node: (untyped) -> void

        # : (untyped) -> void
        def visit_erb_for_node: (untyped) -> void

        # : (untyped) -> void
