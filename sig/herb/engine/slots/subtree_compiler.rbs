      #
      #     require "herb/engine/slots/subtree_compiler"
      #
      #     source = Herb::Engine::Slots::SubtreeCompiler.new(template, node_path: [0, 1]).src
      #     view.instance_eval(source)
      #     #=> "<ul><li>Marco</li></ul>"
