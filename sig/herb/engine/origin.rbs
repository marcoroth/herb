        attr_reader file(): untyped

        attr_reader from(): untyped

        def self.new: (untyped file, untyped from) -> instance
                    | (file: untyped, from: untyped) -> instance

        def self.members: () -> [ :file, :from ]

        def members: () -> [ :file, :from ]
      end

