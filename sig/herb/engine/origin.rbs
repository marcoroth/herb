        # : () -> bool
        def generated?: () -> bool
      end

      GENERATED: Entry

      # : () -> void
      def initialize: () -> void

      # : (Herb::AST::Node, String, ?from: Herb::AST::Node?) -> void
      def authored: (Herb::AST::Node, String, ?from: Herb::AST::Node?) -> void

      # : (Herb::AST::Node) -> void
