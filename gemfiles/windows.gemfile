# frozen_string_literal: true

# Used by the Windows jobs in .github/workflows/build.yml.
#
# The main Gemfile includes gems without Windows builds (e.g. sorbet-static), so this
# only contains what's needed to compile the extension and run the Ruby tests there.

source "https://rubygems.org"

gemspec path: ".."

gem "prism", github: "ruby/prism", tag: "v1.9.0"

# Action View depends on Nokogiri, which doesn't support mswin. The mswin job
# only compiles the extension and runs the CLI, so it doesn't need it.
gem "actionview", "~> 8.1", require: "action_view" unless RUBY_PLATFORM.include?("mswin")
gem "erubi"
gem "fiddle" # used by reline on Windows, no longer a default gem since Ruby 4.0
gem "maxitest", "~> 6.0"
gem "parallel"
gem "rake", "~> 13.4"
gem "rake-compiler", "~> 1.3"
gem "reline", "~> 0.7"
